#!/usr/bin/env bash
set -euo pipefail

# MimikaStudio Control Script
# Local-first voice cloning with Qwen3-TTS

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(dirname "$SCRIPT_DIR")"
BACKEND_DIR="$ROOT_DIR/backend"
FLUTTER_DIR="$ROOT_DIR/flutter_app"
PID_DIR="$ROOT_DIR/.pids"
LOG_DIR="$ROOT_DIR/.logs"
RUNS_LOG_DIR="$ROOT_DIR/runs/logs"

# Locate venv: prefer root-level (install.sh), fall back to backend/venv
if [ -d "$ROOT_DIR/venv" ]; then
    VENV_DIR="$ROOT_DIR/venv"
elif [ -d "$BACKEND_DIR/venv" ]; then
    VENV_DIR="$BACKEND_DIR/venv"
else
    VENV_DIR="$ROOT_DIR/venv"  # default target for auto-creation
fi

# Ports
BACKEND_PORT="${MIMIKA_BACKEND_PORT:-7693}"
MCP_PORT="${MIMIKA_MCP_PORT:-8010}"

# Flutter app metadata
FLUTTER_APP_BUNDLE_ID="com.mimikastudio.app"
FLUTTER_APP_PRODUCT_NAME="MimikaStudio"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

mkdir -p "$PID_DIR" "$LOG_DIR" "$RUNS_LOG_DIR"

# ============== Helper Functions ==============

resolve_python_exec() {
    local candidate
    for candidate in "$VENV_DIR/bin/python" "$VENV_DIR/bin/python3"; do
        if [ -x "$candidate" ] && "$candidate" -c "import sys" >/dev/null 2>&1; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

PYTHON_EXEC="$(resolve_python_exec || true)"

print_status() {
    local name="$1"
    local port="$2"
    local pid_file="$PID_DIR/$name.pid"

    if lsof -ti:"$port" &>/dev/null; then
        local pid=$(lsof -ti:"$port" | head -1)
        echo -e "${GREEN}●${NC} $name: ${GREEN}RUNNING${NC} [PID: $pid, Port: $port]"
    else
        echo -e "${RED}○${NC} $name: ${RED}STOPPED${NC}"
    fi
}

kill_port() {
    local port="$1"
    local pids=$(lsof -ti:"$port" 2>/dev/null || true)
    if [ -n "$pids" ]; then
        echo "$pids" | xargs kill -9 2>/dev/null || true
        sleep 1
    fi
}

wait_for_health() {
    local url="$1"
    local max_retries="${2:-30}"
    local retry=0

    echo -n "Waiting for $url "
    while [ $retry -lt $max_retries ]; do
        if curl -fsS "$url" &>/dev/null; then
            echo -e " ${GREEN}OK${NC}"
            return 0
        fi
        echo -n "."
        sleep 1
        retry=$((retry + 1))
    done
    echo -e " ${RED}FAILED${NC}"
    return 1
}

flutter_app_exec_pattern() {
    echo "$FLUTTER_APP_PRODUCT_NAME.app/Contents/MacOS/$FLUTTER_APP_PRODUCT_NAME"
}

flutter_app_pid() {
    pgrep -f "$(flutter_app_exec_pattern)" 2>/dev/null | head -1 || true
}

is_flutter_app_running() {
    [ -n "$(flutter_app_pid)" ]
}

wait_for_flutter_ui() {
    local max_retries="${1:-240}"
    local retry=0

    echo -n "Waiting for ${FLUTTER_APP_PRODUCT_NAME} UI "
    while [ $retry -lt $max_retries ]; do
        local app_pid
        app_pid="$(flutter_app_pid)"
        if [ -n "$app_pid" ]; then
            echo -e " ${GREEN}OK${NC} [PID: $app_pid]"
            osascript -e "tell application \"$FLUTTER_APP_PRODUCT_NAME\" to activate" 2>/dev/null || open -a "$FLUTTER_APP_PRODUCT_NAME" 2>/dev/null || true
            return 0
        fi
        echo -n "."
        sleep 1
        retry=$((retry + 1))
    done
    echo -e " ${RED}FAILED${NC}"
    return 1
}

flutter_release_app_path() {
    local release_dir="$FLUTTER_DIR/build/macos/Build/Products/Release"
    local candidate
    for candidate in \
        "$release_dir/mimika_studio.app" \
        "$release_dir/$FLUTTER_APP_PRODUCT_NAME.app"
    do
        if [ -d "$candidate" ]; then
            echo "$candidate"
            return 0
        fi
    done

    candidate="$(find "$release_dir" -maxdepth 1 -type d -name '*.app' 2>/dev/null | head -n 1 || true)"
    if [ -n "$candidate" ] && [ -d "$candidate" ]; then
        echo "$candidate"
        return 0
    fi
    return 1
}

embedded_app_bundle_path() {
    local candidate
    for candidate in \
        "$ROOT_DIR/build/dmg-stage/$FLUTTER_APP_PRODUCT_NAME.app" \
        "$ROOT_DIR/build/arm64/$FLUTTER_APP_PRODUCT_NAME.app"
    do
        if [ -d "$candidate" ] && [ -x "$candidate/Contents/Resources/backend/run_backend.sh" ]; then
            echo "$candidate"
            return 0
        fi
    done
    return 1
}

build_embedded_app_bundle() {
    echo -e "${BLUE}Building embedded app bundle via scripts/build_dmg.sh...${NC}"
    cd "$ROOT_DIR"
    # Avoid stale external toolchain overrides that can inject invalid
    # linker search paths (for example old MetalToolchain cryptex mounts).
    env -u TOOLCHAINS "$ROOT_DIR/scripts/build_dmg.sh"
}

ensure_embedded_app_bundle() {
    local embedded_bundle=""
    embedded_bundle="$(embedded_app_bundle_path || true)"
    if [ -n "$embedded_bundle" ]; then
        echo "$embedded_bundle"
        return 0
    fi

    build_embedded_app_bundle
    embedded_bundle="$(embedded_app_bundle_path || true)"
    if [ -z "$embedded_bundle" ]; then
        echo -e "${RED}Embedded app bundle is missing after build_dmg.sh.${NC}" >&2
        return 1
    fi
    echo "$embedded_bundle"
}

# ============== Backend Functions ==============

start_backend() {
    echo -e "${BLUE}Starting backend (source)...${NC}"

    # Kill existing
    kill_port $BACKEND_PORT

    if [ -z "$PYTHON_EXEC" ]; then
        echo -e "${RED}No usable Python executable found under $VENV_DIR.${NC}"
        echo -e "${YELLOW}Run ./install.sh first.${NC}"
        return 1
    fi

    cd "$BACKEND_DIR"
    nohup env \
        MIMIKA_BACKEND_HOST="127.0.0.1" \
        MIMIKA_BACKEND_PORT="$BACKEND_PORT" \
        "$PYTHON_EXEC" -m uvicorn main:app --host 127.0.0.1 --port "$BACKEND_PORT" \
        > "$LOG_DIR/backend.log" 2>&1 &
    echo $! > "$PID_DIR/backend.pid"

    if ! wait_for_health "http://localhost:$BACKEND_PORT/api/health"; then
        echo -e "${RED}Backend startup failed. Last backend log lines:${NC}"
        tail -n 40 "$LOG_DIR/backend.log" 2>/dev/null || true
        return 1
    fi
}

stop_backend() {
    echo -e "${BLUE}Stopping backend...${NC}"
    kill_port $BACKEND_PORT
    rm -f "$PID_DIR/backend.pid"
    echo -e "${GREEN}Backend stopped${NC}"
}

# ============== Flutter Functions ==============

start_flutter() {
    local mode="${1:-release}"
    local release_bundle=""
    release_bundle="$(flutter_release_app_path || true)"
    if [ -z "$release_bundle" ]; then
        echo -e "${YELLOW}Flutter release app bundle not found. Building first...${NC}"
        build_flutter
        release_bundle="$(flutter_release_app_path || true)"
    fi
    if [ -z "$release_bundle" ]; then
        echo -e "${RED}No Flutter release app bundle found after build.${NC}"
        return 1
    fi
    if [ "$mode" != "release" ] && [ "$mode" != "embedded" ]; then
        echo -e "${YELLOW}Unknown Flutter mode '$mode'; using release bundle.${NC}"
    fi
    echo -e "${BLUE}Starting Flutter UI (macOS release app)...${NC}"
    echo -e "${BLUE}Launching app bundle: $release_bundle${NC}"
    open "$release_bundle"
    if ! wait_for_flutter_ui 60; then
        echo -e "${RED}Flutter UI failed to launch.${NC}"
        return 1
    fi
    return 0
}

stop_flutter() {
    echo -e "${BLUE}Stopping Flutter UI...${NC}"

    # Kill by PID file
    if [ -f "$PID_DIR/flutter.pid" ]; then
        kill $(cat "$PID_DIR/flutter.pid") 2>/dev/null || true
        rm -f "$PID_DIR/flutter.pid"
    fi

    # Kill app by bundle ID
    osascript -e "quit app \"$FLUTTER_APP_PRODUCT_NAME\"" 2>/dev/null || true
    osascript -e "quit app id \"$FLUTTER_APP_BUNDLE_ID\"" 2>/dev/null || true

    local app_pids
    app_pids="$(pgrep -f "$(flutter_app_exec_pattern)" || true)"
    if [ -n "$app_pids" ]; then
        echo "$app_pids" | xargs kill -9 2>/dev/null || true
    fi

    echo -e "${GREEN}Flutter stopped${NC}"
}

build_flutter() {
    echo -e "${BLUE}Building Flutter macOS release app...${NC}"
    cd "$FLUTTER_DIR"
    # Avoid stale external toolchain overrides and skip redundant pub resolves.
    env TOOLCHAINS="com.apple.dt.toolchain.XcodeDefault" \
        flutter build macos --release --no-pub
    local release_bundle=""
    release_bundle="$(flutter_release_app_path || true)"
    if [ -z "$release_bundle" ]; then
        echo -e "${RED}Flutter build succeeded but no .app bundle was found.${NC}"
        return 1
    fi
    echo -e "${GREEN}Flutter release build complete${NC}"
    echo -e "Bundle: $release_bundle"
}

# ============== Model Functions ==============

download_models() {
    echo -e "${BLUE}Downloading models...${NC}"
    source "$VENV_DIR/bin/activate"

    # Models are auto-downloaded on first use
    # This just pre-warms them
    python3 -c "
from tts.kokoro_engine import get_kokoro_engine

print('Loading Kokoro model...')
get_kokoro_engine().load_model()

print('All models loaded.')
"
    echo -e "${GREEN}Models ready${NC}"
}

# ============== MCP Functions ==============

start_mcp() {
    echo -e "${BLUE}Starting MCP Server...${NC}"

    # Kill existing
    kill_port $MCP_PORT

    # Activate venv
    if [ -f "$VENV_DIR/bin/activate" ]; then
        source "$VENV_DIR/bin/activate"
    fi

    # Start MCP server
    nohup env MIMIKASTUDIO_BACKEND_URL="http://localhost:$BACKEND_PORT" python3 "$SCRIPT_DIR/tts_mcp_server.py" --host 127.0.0.1 --port $MCP_PORT > "$RUNS_LOG_DIR/mcp_server.log" 2>&1 &
    echo $! > "$PID_DIR/mcp.pid"

    sleep 1
    if lsof -ti:"$MCP_PORT" &>/dev/null; then
        echo -e "${GREEN}MCP Server started${NC} on port $MCP_PORT"
    else
        echo -e "${RED}MCP Server failed to start${NC}"
        tail -5 "$RUNS_LOG_DIR/mcp_server.log" 2>/dev/null || true
    fi
}

stop_mcp() {
    echo -e "${BLUE}Stopping MCP Server...${NC}"
    kill_port $MCP_PORT
    rm -f "$PID_DIR/mcp.pid"
    echo -e "${GREEN}MCP Server stopped${NC}"
}

# ============== Database Functions ==============

seed_db() {
    echo -e "${BLUE}Seeding database...${NC}"
    source "$VENV_DIR/bin/activate"
    cd "$BACKEND_DIR"
    python3 database.py
    echo -e "${GREEN}Database seeded${NC}"
}

# ============== Test Functions ==============

run_tests() {
    echo -e "${BLUE}Running API tests...${NC}"
    source "$VENV_DIR/bin/activate"
    python3 "$ROOT_DIR/scripts/test_api.py"
}

cmd_flutter_start() {
    local mode="release"

    while [[ $# -gt 0 ]]; do
        case $1 in
            --embedded|--release) mode="release" ;;
            --dev)
                echo -e "${RED}Dev mode is disabled. Use release mode only.${NC}"
                return 1
                ;;
            *)
                echo "Unknown option: $1"
                return 1
                ;;
        esac
        shift
    done

    start_flutter "$mode"
}

# ============== Main Commands ==============

cmd_up() {
    local skip_flutter=false
    local skip_mcp=false

    while [[ $# -gt 0 ]]; do
        case $1 in
            --no-flutter) skip_flutter=true ;;
            --no-mcp) skip_mcp=true ;;
            --flutter-release|--flutter-embedded) ;;
            *)
                echo "Unknown option: $1"
                exit 1
                ;;
        esac
        shift
    done

    echo -e "${BLUE}=== Starting MimikaStudio ===${NC}"
    if [ "$skip_flutter" = false ]; then
        echo -e "${BLUE}Forcing Flutter release build before startup...${NC}"
        build_flutter
    fi
    start_backend

    if [ "$skip_mcp" = false ]; then
        start_mcp
    fi

    if [ "$skip_flutter" = false ]; then
        start_flutter release
    fi

    echo ""
    echo -e "${GREEN}=== MimikaStudio Ready ===${NC}"
    echo -e "Backend:    http://localhost:$BACKEND_PORT"
    echo -e "API Docs:   http://localhost:$BACKEND_PORT/docs"
    echo -e "MCP Server: http://localhost:$MCP_PORT"
}

cmd_dist() {
    echo -e "${BLUE}=== Building Distribution Artifacts ===${NC}"
    build_embedded_app_bundle
    echo -e "${GREEN}=== Distribution Build Complete ===${NC}"
}

cmd_down() {
    echo -e "${BLUE}=== Stopping MimikaStudio ===${NC}"
    stop_flutter
    stop_mcp
    stop_backend
    echo -e "${GREEN}=== MimikaStudio Stopped ===${NC}"
}

cmd_status() {
    echo -e "${BLUE}=== MimikaStudio Status ===${NC}"
    echo ""
    echo -e "${GREEN}Services:${NC}"
    print_status "Backend" $BACKEND_PORT
    print_status "MCP Server" $MCP_PORT

    # Flutter status
    local flutter_launch_pid=""
    if [ -f "$PID_DIR/flutter.pid" ]; then
        local pid=$(cat "$PID_DIR/flutter.pid")
        if kill -0 "$pid" 2>/dev/null; then
            flutter_launch_pid="$pid"
        fi
    fi

    local app_pid
    app_pid="$(flutter_app_pid)"
    if [ -n "$app_pid" ]; then
        echo -e "${GREEN}●${NC} Flutter UI: ${GREEN}RUNNING${NC} [PID: $app_pid]"
    elif [ -n "$flutter_launch_pid" ]; then
        echo -e "${YELLOW}◐${NC} Flutter UI: ${YELLOW}STARTING${NC} [Launcher PID: $flutter_launch_pid]"
    else
        echo -e "${RED}○${NC} Flutter UI: ${RED}STOPPED${NC}"
    fi

    echo ""
    echo -e "${GREEN}Logs:${NC}"
    echo "  mimikactl logs backend   - Backend logs"
    echo "  mimikactl logs mcp       - MCP server logs"
    echo "  mimikactl logs flutter   - Flutter logs"
    echo "  mimikactl logs all       - Tail all logs"
}

cmd_restart() {
    cmd_down
    sleep 2
    cmd_up "$@"
}

cmd_logs() {
    local target="${1:-backend}"

    case "$target" in
        backend)
            log_file="$LOG_DIR/backend.log"
            ;;
        mcp)
            log_file="$RUNS_LOG_DIR/mcp_server.log"
            ;;
        flutter)
            log_file="$LOG_DIR/flutter.log"
            ;;
        all)
            echo "Tailing all logs (Ctrl+C to exit)..."
            tail -f "$LOG_DIR"/*.log "$RUNS_LOG_DIR"/*.log 2>/dev/null
            return
            ;;
        *)
            log_file="$LOG_DIR/$target.log"
            if [ ! -f "$log_file" ]; then
                log_file="$RUNS_LOG_DIR/$target.log"
            fi
            ;;
    esac

    if [ -f "$log_file" ]; then
        echo "Tailing $log_file (Ctrl+C to exit)..."
        tail -f "$log_file"
    else
        echo "Log file not found: $log_file"
        echo "Available logs:"
        ls -1 "$LOG_DIR"/*.log "$RUNS_LOG_DIR"/*.log 2>/dev/null || echo "  (none)"
    fi
}

# ============== Usage ==============

usage() {
    cat << EOF
${BLUE}MimikaStudio Control Script${NC}

Usage: mimikactl <command> [options]

${GREEN}Service Commands:${NC}
    up [options]                Build Flutter app, then start services (Backend + MCP + Flutter)
        --no-flutter            Skip Flutter UI
        --no-mcp                Skip MCP server
        --flutter-embedded      Deprecated alias (ignored; release app is used)
    dist                        Build embedded app + DMG distribution artifacts
    down                        Stop all services
    restart                     Restart all services
    status                      Show service status

${GREEN}Backend Commands:${NC}
    backend start               Start backend only
    backend stop                Stop backend

${GREEN}Flutter Commands:${NC}
    flutter start [--embedded]  Start Flutter UI from Flutter release app bundle
    flutter stop                Stop Flutter UI
    flutter build               Build Flutter macOS release app only

${GREEN}MCP Server Commands:${NC}
    mcp start                   Start MCP server (for Codex CLI)
    mcp stop                    Stop MCP server
    mcp status                  Check MCP server status

${GREEN}Model Commands:${NC}
    models download             Pre-download ML models

${GREEN}Database Commands:${NC}
    db seed                     Seed database

${GREEN}Utility Commands:${NC}
    logs [service]              Tail logs (backend|mcp|flutter|all)
    test                        Run API tests
    clean                       Clean logs and temp files
    version                     Show version info

${GREEN}Examples:${NC}
    mimikactl up                   # Start everything
    mimikactl up --no-flutter      # Backend + MCP only
    mimikactl status               # Check what's running
    mimikactl logs backend         # Tail backend logs
    mimikactl mcp start            # Start MCP for Codex CLI

EOF
}

# ============== Main ==============

case "${1:-}" in
    up) shift; cmd_up "$@" ;;
    dist) cmd_dist ;;
    down) cmd_down ;;
    restart) shift; cmd_restart "$@" ;;
    status) cmd_status ;;
    backend)
        case "${2:-}" in
            start) start_backend ;;
            stop) stop_backend ;;
            *) echo "Usage: mimikactl backend {start|stop}" ;;
        esac
        ;;
    flutter)
        case "${2:-}" in
            start) shift 2; cmd_flutter_start "$@" ;;
            stop) stop_flutter ;;
            build) build_flutter ;;
            *) echo "Usage: mimikactl flutter {start|stop|build}" ;;
        esac
        ;;
    mcp)
        case "${2:-}" in
            start) start_mcp ;;
            stop) stop_mcp ;;
            status)
                echo -e "${BLUE}MCP Server Status:${NC}"
                print_status "MCP Server" $MCP_PORT
                ;;
            *) echo "Usage: mimikactl mcp {start|stop|status}" ;;
        esac
        ;;
    models)
        case "${2:-}" in
            download) download_models ;;
            *) echo "Usage: mimikactl models download" ;;
        esac
        ;;
    db)
        case "${2:-}" in
            seed) seed_db ;;
            *) echo "Usage: mimikactl db seed" ;;
        esac
        ;;
    logs) shift; cmd_logs "${1:-backend}" ;;
    test) run_tests ;;
    clean)
        echo -e "${BLUE}Cleaning temporary files...${NC}"
        rm -rf "$LOG_DIR"/*.log 2>/dev/null || true
        rm -rf "$RUNS_LOG_DIR"/*.log 2>/dev/null || true
        rm -rf "$PID_DIR"/*.pid 2>/dev/null || true
        echo -e "${GREEN}Cleaned.${NC}"
        ;;
    version)
        echo -e "${BLUE}MimikaStudio - Text-to-Speech UI${NC}"
        echo "Version: 1.0.0"
        echo "Root: $ROOT_DIR"
        echo ""
        echo "Components:"
        command -v python3 >/dev/null && echo "  Python: $(python3 --version 2>&1 | cut -d' ' -f2)"
        command -v flutter >/dev/null && echo "  Flutter: $(flutter --version 2>&1 | head -1 | cut -d' ' -f2)"
        ;;
    generate)
        case "${2:-}" in
            emma-audio)
                echo -e "${BLUE}Generating Emma IPA audio...${NC}"
                source "$VENV_DIR/bin/activate"
                python3 "$BACKEND_DIR/scripts/generate_emma_ipa_audio.py"
                echo -e "${GREEN}Audio generated${NC}"
                ;;
            *) echo "Usage: mimikactl generate {emma-audio}" ;;
        esac
        ;;
    help|-h|--help) usage ;;
    *) usage ;;
esac
